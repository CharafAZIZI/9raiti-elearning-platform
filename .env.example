# Copie ce fichier en .env puis remplace les valeurs.
# Ne commite JAMAIS le fichier .env.

# Mot de passe des bases PostgreSQL (cours + notifications)
DB_PASSWORD=change_me

# Mot de passe SQL Server (min. 8 caractères, avec majuscule, minuscule et chiffre)
SQLSERVER_PASSWORD=Change_me_123

# Mot de passe MinIO (min. 8 caractères)
MINIO_PASSWORD=change_me_123

# Clé de signature JWT, identique pour les services .NET et Spring (min. 32 caractères)
JWT_SECRET=change_me_with_a_long_random_string_32_chars_min

# Compte email utilisé pour envoyer les emails (Gmail + mot de passe d'application)
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=change_me

# Clé API Groq (https://console.groq.com)
GROQ_API_KEY=change_me